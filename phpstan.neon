includes:
  - vendor/phpstan/phpstan-phpunit/extension.neon
parameters:
  bootstrapFiles:
    - tests/F4/Config.php

services:
  # F4\DB documents every method as both static and non-static, this extension from f4php/db resolves static calls
  -
    class: F4\PHPStan\Reflection\DB\DBClassReflectionExtension
    tags:
      - phpstan.broker.methodsClassReflectionExtension
